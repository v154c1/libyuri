<?xml version="1.0" ?>
<app name="pulse" xmlns="urn:library:yuri:xmlschema:2001" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <variable name="sink" description="Audio card for playback">0</variable>

    <general>
        <parameter name="run_limit">-1</parameter>
        <parameter name="debug">0</parameter>
    </general>

    <node class="pulse_input" name="input" />
    <node class="frame_info" name="finfo" />
    <node class="pipewire_output" name="output">
        <parameter name="sink">@sink</parameter>
    </node>
    <node class="event_info" name="einfo" />

    <link name="sound_pipe_in" class="single" source="input:0" target="finfo:0"/>
    <link name="sound_pipe_out" class="unlimited" source="finfo:0" target="output:0"/>

    <event>
        route(output:*)->einfo:*;
    </event>
</app>
